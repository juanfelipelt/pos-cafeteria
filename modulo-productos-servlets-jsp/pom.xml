<?xml version="1.0" encoding="UTF-8"?>
<!--
  Proyecto: Cafetería POS - Modulo de Productos (Servlets + JSP)
  Evidencia: GA7-220501096-AA2-EV02 (Modulos de software codificados y probados)
  Programa: Tecnologia en Analisis y Desarrollo de Software - SENA
